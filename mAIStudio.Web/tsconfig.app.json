{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": ["./src/*"],
      "@web-shared/*": ["../WebShared/src/*"],
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"],
      "react-router-dom": ["./node_modules/react-router-dom"],
      "axios": ["./node_modules/axios"],
      "antd": ["./node_modules/antd"],
      "antd/*": ["./node_modules/antd/*"],
      "@ant-design/icons": ["./node_modules/@ant-design/icons"],
      "katex": ["./node_modules/katex"],
      "jszip": ["./node_modules/jszip"],
      "docx-preview": ["./node_modules/docx-preview"],
      "pptx-preview": ["./node_modules/pptx-preview"],
      "@tiptap/*": ["./node_modules/@tiptap/*"],
      "mathlive": ["./node_modules/mathlive"],
      "dompurify": ["./node_modules/dompurify"],
      "mathml-to-latex": ["./node_modules/mathml-to-latex"],
      "recharts": ["./node_modules/recharts"]
    }
  },
  "include": ["src"]
}
